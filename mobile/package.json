{
  "name": "runway-rally-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iPhone and Android apps for Runway Rally (Capacitor). The game files come from ../web.",
  "engines": { "node": ">=20" },
  "scripts": {
    "web": "node scripts/build-web.mjs",
    "sync": "node scripts/build-web.mjs && cap sync",
    "android": "node scripts/build-web.mjs && cap sync android && cap open android",
    "ios": "node scripts/build-web.mjs && cap sync ios && cap open ios",
    "icons": "node scripts/make-icon.mjs && capacitor-assets generate --android --ios --iconBackgroundColor '#6a4cff' --splashBackgroundColor '#fff4fb'",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}
