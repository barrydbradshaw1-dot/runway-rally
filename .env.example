# Copy to .env and fill in. Never commit .env.

# Public hostname pointing at the droplet (an A record), e.g. rally.example.com
DOMAIN=rally.example.com

# Admin token for the teacher dashboard endpoint. Generate with: openssl rand -hex 24
ADMIN_TOKEN=
# How long data is kept, in days (0 turns a rule off). See "Data retention" in the README.
# RETENTION_ANSWER_DAYS=365
# RETENTION_INACTIVE_DAYS=730
# RETENTION_CLASS_END_DAYS=30
# RETENTION_AUDIT_DAYS=1095

# --- Option A: bundled Postgres (start with: docker compose --profile localdb up -d --build) ---
# Use the same password in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://rally:REPLACE_WITH_THE_SAME_PASSWORD@db:5432/rally
PGSSLMODE=disable

# --- Option B: DigitalOcean Managed Postgres (start with: docker compose up -d --build) ---
# Replace the two lines above with:
# DATABASE_URL=postgres://user:pass@host:25060/defaultdb?sslmode=require
# DATABASE_SSL=1

# --- Brightspace / LTI 1.3 (optional; see README "Brightspace (D2L) setup") ---
# LTI_TOOL_URL=https://rally.example.com
# openssl genrsa 2048 | base64 -w0
# LTI_PRIVATE_KEY_B64=
# openssl rand -hex 32
# LTI_SESSION_SECRET=
# One JSON array on a single line. Values come from Brightspace after you register the tool.
# LTI_PLATFORMS=[{"issuer":"https://yourdistrict.brightspace.com","clientId":"","deploymentIds":[""],"authUrl":"","tokenUrl":"","audience":"","jwksUrl":""}]
# completion = 20 points per finished commission (effort), mastery = average mastery
# LTI_SCORE_MODE=completion
# Set to 1 to keep "Given F." as the nickname instead of "Designer 1234"
# LTI_STORE_NAMES=0
