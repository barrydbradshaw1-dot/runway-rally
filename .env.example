# Copy to .env and fill in. Never commit .env.

# Public hostname pointing at the droplet (an A record), e.g. rally.example.com
DOMAIN=rally.example.com

# Admin token for the teacher dashboard endpoint. Generate with: openssl rand -hex 24
ADMIN_TOKEN=

# --- Option A: bundled Postgres (start with: docker compose --profile localdb up -d --build) ---
# Use the same password in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://rally:REPLACE_WITH_THE_SAME_PASSWORD@db:5432/rally
PGSSLMODE=disable

# --- Option B: DigitalOcean Managed Postgres (start with: docker compose up -d --build) ---
# Replace the two lines above with:
# DATABASE_URL=postgres://user:pass@host:25060/defaultdb?sslmode=require
# DATABASE_SSL=1
