{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Anyone who types www. lands on the main address, with the same path.
# Needs a DNS record for www pointing at the droplet (an A record or a CNAME to the main name).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
